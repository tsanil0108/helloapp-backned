# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helloDB
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=10
DB_POOL_MIN=2

# JWT - generate a random 32+ byte secret
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=1209600000

# Frontend origins, comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notification integrations
FIREBASE_ENABLED=false
SMS_ENABLED=false
WHATSAPP_ENABLED=false
EMAIL_ENABLED=false

# Password reset email
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_MAIL_FROM=no-reply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CAPTCHA (enable in production; use the matching Google reCAPTCHA server secret)
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
